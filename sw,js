self.addEventListener('install', (event) => {
  self.skipWaiting();
});

self.addEventListener('activate', (event) => {
  console.log('Service worker active');
});

self.addEventListener('fetch', (event) => {
  // Basic pass-through (you can enhance later)
});

// Shows a notification for genuine server-sent push messages, if a push
// server is ever added. Currently unused by this static app — notifications
// are triggered client-side via registration.showNotification() instead.
self.addEventListener('push', (event) => {
  var data = {};
  try { data = event.data ? event.data.json() : {}; } catch (e) {}
  var title = data.title || 'Sorcery Grimoire';
  var options = {
    body: data.body || '',
    icon: 'icons/icon-192.png',
    badge: 'icons/icon-192.png',
  };
  event.waitUntil(self.registration.showNotification(title, options));
});

// Focus an existing app tab if one is open, otherwise open a new one.
self.addEventListener('notificationclick', (event) => {
  event.notification.close();
  event.waitUntil(
    self.clients.matchAll({ type: 'window', includeUncontrolled: true }).then((clientList) => {
      for (const client of clientList) {
        if ('focus' in client) return client.focus();
      }
      if (self.clients.openWindow) return self.clients.openWindow('./');
    })
  );
});
